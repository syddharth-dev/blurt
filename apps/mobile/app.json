{
  "expo": {
    "name": "Blurt!",
    "slug": "blurt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.blurt.mobile",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Blurt! turns what you say into text to check your answer. Your voice stays on your phone when possible.",
        "NSMicrophoneUsageDescription": "Blurt! listens when you tap the mic so you can say the science term out loud."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#160C3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.blurt.mobile",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#160C3A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Blurt! listens when you tap the mic so you can say the science term out loud.",
          "speechRecognitionPermission": "Blurt! turns what you say into text to check your answer. Your voice stays on your phone when possible.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "blurt",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a648a958-94eb-4289-95f7-72350690cc79"
      }
    },
    "owner": "syddharth-dev"
  }
}
