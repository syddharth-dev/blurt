# Blurt! mobile app. Copy to .env.local. EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to "mock" to use scripted speech (emulators, demos). Leave unset on a real phone.
EXPO_PUBLIC_SPEECH=
