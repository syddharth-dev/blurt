# Blurt! API. Copy to .env for local development. Never commit .env.
# See docs/DEPLOYMENT.md for what each value is and where it comes from.

PORT=3000
NODE_ENV=development

# Supabase Postgres
DATABASE_URL=            # pooled connection string (used by the app)
DIRECT_URL=              # direct connection (used by migrations)

# Supabase Auth — the API verifies user JWTs against the project's JWKS
SUPABASE_URL=            # e.g. https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # server only, never in the app or dashboard

REDIS_URL=redis://localhost:6379
SENTRY_DSN=
CORS_ORIGINS=http://localhost:3001   # comma-separated; the dashboard's URL
